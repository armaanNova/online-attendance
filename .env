# ===================================================
# Database Configuration (MySQL / XAMPP)
# ===================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=face_attendance_db

# ===================================================
# Application & Security Settings
# ===================================================
SECRET_KEY=bca_smart_face_attendance_secret_key_2026_super_secure!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================================================
# Computer Vision & Face Recognition Settings
# ===================================================
# Cosine similarity threshold for face match (0.0 to 1.0)
FACE_MATCH_THRESHOLD=0.72

# Minimum face resolution box (width/height in pixels)
MIN_FACE_SIZE=60

# ===================================================
# College Campus Geofencing & Location Verification
# ===================================================
# Set to true to strictly verify that students are inside college premises
ENABLE_GEOFENCE=false
# College Campus Coordinates (Latitude & Longitude)
COLLEGE_LATITUDE=28.6139
COLLEGE_LONGITUDE=77.2090
# Allowed radius in meters around college campus (e.g. 500m)
COLLEGE_RADIUS_METERS=500
